# Copy to .env for local development. In deployed environments (staging /
# production) these are set by the EC2 launch template's user-data instead —
# see infrastructure/terraform/modules/compute/templates/user_data.sh.tpl.
# DB_USERNAME / DB_PASSWORD and the JWT secrets are deliberately absent from
# both — the app reads those from Secrets Manager in production, and from
# the local-only values below in development (see src/config/secrets.js).

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=silas_mobiles
DB_USERNAME=silas_app
DB_PASSWORD=silas_dev_password

# Only used when NODE_ENV=development — see src/config/secrets.js
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me

AWS_REGION=af-south-1
UPLOADS_BUCKET=

CORS_ORIGIN=http://localhost:5173
