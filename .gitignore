# Dependencies
node_modules/

# Build output
dist/
build/

# Environment files — never commit real secrets
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
logs/

# OS / editor
.DS_Store
.vscode/
.idea/

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# NOTE: .terraform.lock.hcl is deliberately NOT ignored — commit it, it
# pins provider versions the same way package-lock.json pins npm versions.
# NOTE: environments/*.tfvars are deliberately NOT ignored either — they
# hold instance sizes and non-secret config, never credentials (the actual
# DB password and JWT secrets are generated by Terraform itself and only
# ever live in Secrets Manager).
